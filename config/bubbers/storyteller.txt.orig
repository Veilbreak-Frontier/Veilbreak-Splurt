#DEFAULT_MAJOR_POINTS_THRESHOLD_COEFFICIENT 1
#DEFAULT_CREWSET_POINTS_THRESHOLD_COEFFICIENT 1
#DEFAULT_GHOSTSET_POINTS_THRESHOLD_COEFFICIENT 1

